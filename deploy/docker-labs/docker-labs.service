[Unit]
Description=Docker Engine for LinuxTraining labs (user-namespace remapped)
Documentation=file:///opt/linuxtraining/docs/deployment.md
After=containerd.service docker.service
Wants=containerd.service

[Service]
Type=notify
# Its own network namespace (ltlabs): the labs' bridges and interfaces exist only there (no route to the host, the
# internet or each other: forwarding is off in a fresh namespace). A second dockerd in the host namespace deletes
# docker0, the main daemon's bridge (found on the test host). nsenter switches only the network namespace:
# PrivateNetwork= would also give dockerd a private mount namespace, and runc (started via containerd in the host's)
# would see empty container root filesystems. The backend uses the Unix socket; docker exec needs no network.
ExecStartPre=/usr/bin/install -d -m 0750 /run/lt-labs
ExecStartPre=/bin/sh -c 'ip netns list | grep -qw ltlabs || ip netns add ltlabs; ip -n ltlabs link set lo up'
ExecStart=/usr/bin/nsenter --net=/run/netns/ltlabs /usr/bin/dockerd --config-file /etc/docker-labs/daemon.json
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
LimitNOFILE=1048576
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
